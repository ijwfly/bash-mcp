# Copy to .env and adjust. All variables are read by docker-compose.yml.

# --- Auth -------------------------------------------------------------------
# Shared HMAC secret for JWT auth. Setting it enables multi-user mode:
# each token's `sub` claim maps to an isolated Linux user + workspace.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Open access without any auth (everything runs as root). Only for local
# experiments; ignored when JWT_SECRET is set.
ALLOW_NO_AUTH=

# --- Admin API --------------------------------------------------------------
# Enable HTTP admin endpoints (/admin/users ...) for creating, listing and
# revoking users. Both must be set for the routes to be registered.
ENABLE_ADMIN_API=
# Static bearer token for the admin API. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# --- Tools ------------------------------------------------------------------
# Set to false to expose only bash_exec (no read_file/write_file/edit_file).
ENABLE_FILE_TOOLS=true

# Upper bound for the bash_exec timeout parameter, in seconds.
BASH_TIMEOUT_MAX=300

# --- Per-user resource limits (applied to sudo -u sessions) -----------------
# Max processes per user (fork-bomb protection).
USER_MAX_PROCS=256
# Max virtual memory per process, in MB.
USER_MAX_MEM_MB=4096

# --- Container resource limits ----------------------------------------------
CONTAINER_MEM_LIMIT=2g
CONTAINER_CPUS=2
CONTAINER_PIDS_LIMIT=512
